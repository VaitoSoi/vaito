---
import ProjectLink from "./ProjectLink.astro";
interface Props {
    name: string;
    icon?: string;
    tags: string[];
    desc: string;
    links: {
        repo: string;
        docs?: string;
        npm?: string;
        pypi?: string;
        // crate?: string;
        // docker?: string;
        related?: string;
    };
    short?: {
        name: string;
        desc: string;
    };
}
const {
    name,
    icon,
    tags,
    desc,
    links: {
        repo,
        docs,
        npm,
        pypi,
        // crate,
        // docker,
        related,
    },
    short,
} = Astro.props;
---

<div
    class={"size-full flex flex-col border-2 rounded-md border-dashed xl:px-10 xl:py-5 p-5 gap-2 " +
        "xl:hover:border-solid xl:hover:-translate-y-1 transition-all ease duration-150"}
>
    <div class="flex-4 flex flex-col xl:gap-5">
        <div
            class={"flex-1 flex-row gap-5 items-center" +
                (short ? " hidden xl:flex" : " flex")}
        >
            {icon && <img class="h-[3vh]" src={`/projects/${icon}`} />}
            <h2 class="xl:text-4xl xl:text-3xl font-bold text-amber-200">{name}</h2>
            <p class="xl:text-xl whitespace-pre-line hidden xl:inline">
                {tags.map((val) => `#${val}`).join(" ")}
            </p>
        </div>
        <p
            class={"flex-5 xl:text-2xl xl:text-xl text-lg" +
                (short ? " hidden xl:inline" : "")}
        >
            {
                desc.split("\n").map((val) => (
                    <span>
                        {val}
                        <br />
                    </span>
                ))
            }
        </p>
        {
            short 
            ? <div
                class="flex-1 flex-row gap-5 items-center xl:hidden flex"
            >
                {icon && <img class="h-[3vh]" src={`/projects/${icon}`} />}
                <h2 class="text-4xl font-bold text-amber-200">{short.name}</h2>
                <p class="text-2xl whitespace-pre-line hidden xl:inline">
                    {tags.map((val) => `#${val}`).join(" ")}
                </p>
            </div>
            <p
                class="flex-5 xl:text-2xl text-lg xl:hidden inline"
            >
                {
                    short.desc.split("\n").map((val) => (
                        <span>
                            {val}
                            <br />
                        </span>
                    ))
                }
            </p> 
        : <Fragment />
        }
    </div>
    <div class="border border-dashed border-amber-100/50"></div>
    <div
        class="flex-1 flex flex-row gap-5 items-center overflow-y-hidden overflow-x-auto"
    >
        <ProjectLink url={repo} icon="git.svg" name="repo" />
        {docs && <ProjectLink url={docs} icon="wiki.svg" name="docs" />}
        {npm && <ProjectLink url={npm} icon="npm.svg" name="npm" />}
        {pypi && <ProjectLink url={pypi} icon="pypi.png" name="pypi" />}
        <!-- {crate && <ProjectLink url={crate} icon="crate.svg" name="crate" />} -->
        <!-- {docker && <ProjectLink url={docker} icon="docker.svg" name="docker" />} -->
        {
            related && (
                <ProjectLink
                    url={related}
                    icon="related.svg"
                    name="related project"
                />
            )
        }
    </div>
</div>
